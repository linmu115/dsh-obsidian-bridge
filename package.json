{
  "name": "dsh-obsidian-bridge",
  "version": "0.4.1-dsh021.1",
  "description": "Unified DSH Obsidian Bridge with explicit Vault binding, routed reference channels and optional independent consumers.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./package.json": "./package.json",
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./typert": {
      "types": "./dist/typert.d.ts",
      "default": "./dist/typert.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./protocol/data": {
      "types": "./dist/protocol/data.d.ts",
      "default": "./dist/protocol/data.js"
    },
    "./protocol/binding": {
      "types": "./dist/protocol/binding.d.ts",
      "default": "./dist/protocol/binding.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "docs/changes",
    "docs/cli-operations.md",
    "docs"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm build && pnpm typecheck && pnpm exec vitest run && pnpm pack --dry-run --json",
    "prebuild": "pnpm --filter dsh-obsidian-bridge-protocol build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "package:release": "node scripts/package-release.mjs",
    "prepare:host": "node scripts/prepare-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "*",
    "dsh-annotation-core": "0.3.12-dsh021.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "dsh-annotation-core": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:.dsh-host/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:.dsh-host/packages/core/agent",
    "@deepseek-ai/dsh-llm": "link:.dsh-host/packages/llm/llm",
    "@deepseek-ai/dsh-scope": "link:.dsh-host/packages/core/scope",
    "@deepseek-ai/dsh-session": "link:.dsh-host/packages/core/session",
    "@deepseek-ai/dsh-session-projection": "link:.dsh-host/packages/session/session-projection",
    "@deepseek-ai/dsh-skill": "link:.dsh-host/packages/skill/skill",
    "@deepseek-ai/dsh-system-prompt": "link:.dsh-host/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:.dsh-host/packages/core/tools",
    "@deepseek-ai/dsh-typert-protocol": "link:.dsh-host/packages/typert/protocol",
    "@deepseek-ai/dsh-typert-registry": "link:.dsh-host/packages/typert/registry",
    "@deepseek-ai/dsh-user-approval": "link:.dsh-host/packages/interaction/user-approval",
    "@deepseek-ai/schemastery": "link:.dsh-host/vendor/schemastery",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "dsh-annotation-core": "link:../dsh-annotation-core",
    "dsh-obsidian-bridge-protocol": "workspace:*",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11",
    "@deepseek-ai/dsh-storage-domain": "link:.dsh-host/packages/storage/storage-domain",
    "@deepseek-ai/dsh-storage": "link:.dsh-host/packages/storage/storage",
    "tar": "7.5.22",
    "@deepseek-ai/dsh-client-ui-workspace": "link:.dsh-host/packages/client/ui-workspace",
    "@deepseek-ai/dsh-api-session-controller": "link:.dsh-host/packages/api/session-controller"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshKnowledge": {
    "bridgeLifecycleProtocolVersion": 3
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/dsh-obsidian-bridge.git"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
